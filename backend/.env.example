# ============================================
# 应用配置 - 复制为 .env 后按需修改
#   复制命令：cp .env.example .env
# ============================================

# JWT 密钥（生产环境务必更换为随机长字符串）
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- 数据库（腾讯云 MySQL / TDSQL-C）----------
# 团队共享同一个数据库，复制为 .env 后即可直接启动。
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
# 注意：密码含特殊字符需 URL 编码，例如 @ -> %40，! -> %21，# -> %23，空格 -> %20
DATABASE_URL=mysql+pymysql://root:Fuck%40123@cd-cynosdbmysql-grp-fxrzczki.sql.tencentcdb.com:29081/competition_team?charset=utf8mb4

# CORS 允许的前端地址
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
